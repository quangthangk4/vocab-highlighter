{
  "manifest_version": 3,
  "name": "Vocab Highlighter",
  "version": "3.0.0",
  "description": "Save vocabulary words while browsing and automatically highlight them on every page you visit.",

  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://api.dictionaryapi.dev/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Vocab Highlighter"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
